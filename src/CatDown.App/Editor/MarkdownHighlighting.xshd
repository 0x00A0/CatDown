<?xml version="1.0"?>
<!-- Colors are filled in at runtime from the Semi theme, see EditorTheme. -->
<SyntaxDefinition name="CatDownMarkdown" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Heading" fontWeight="bold" />
  <Color name="Strong" fontWeight="bold" />
  <Color name="Emphasis" fontStyle="italic" />
  <Color name="Code" />
  <Color name="Link" />
  <Color name="Marker" />
  <RuleSet>
    <Span color="Code">
      <Begin>`</Begin>
      <End>`</End>
    </Span>
    <Rule color="Heading">^\#{1,6}\s.*</Rule>
    <Rule color="Link">!?\[[^\]\n]*\]\([^)\n]*\)</Rule>
    <Rule color="Strong">\*\*[^*\n]+\*\*|__[^_\n]+__</Rule>
    <Rule color="Emphasis">\*[^*\n]+\*|(?&lt;!\w)_[^_\n]+_(?!\w)</Rule>
    <Rule color="Marker">^\s*([-*+]|\d+\.)\s|^\s*&gt;</Rule>
  </RuleSet>
</SyntaxDefinition>
