<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CatDown.App.ViewModels"
             xmlns:loc="using:CatDown.App.Localization"
             xmlns:editor="using:CatDown.App.Editor"
             xmlns:preview="using:CatDown.App.Preview"
             xmlns:controls="using:CatDown.App.Controls"
             xmlns:views="using:CatDown.App.Views"
             x:Class="CatDown.App.Views.SegmentGridView"
             x:DataType="vm:SegmentGridViewModel">
  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="Border.row.blockStart">
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorText3}" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText3}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.status.draft">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    </Style>
    <Style Selector="TextBlock.status.confirmed">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
    </Style>
    <Style Selector="TextBlock.status.review">
      <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
    </Style>
    <Style Selector=":is(TextBlock).verbatim">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
      <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,0" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="{Binding PreviewButtonText}" Command="{Binding TogglePreviewCommand}" />
        <Button x:Name="LayoutButton" DockPanel.Dock="Right" Margin="0,0,8,0" Theme="{DynamicResource BorderlessButton}"
                Content="{Binding LayoutButtonText}" Command="{Binding ToggleLayoutCommand}" IsEnabled="{Binding !IsPreview}" />
        <WrapPanel IsEnabled="{Binding !IsPreview}">
          <Button x:Name="ConfirmButton" Theme="{DynamicResource BorderlessButton}" Content="{loc:Str Confirm}" Command="{Binding ConfirmCommand}" />
          <Button Theme="{DynamicResource BorderlessButton}" Content="{loc:Str MachineTranslate}" Command="{Binding MachineTranslateCommand}" />
          <Button x:Name="TranslateAllButton" Theme="{DynamicResource BorderlessButton}" Content="{loc:Str MachineTranslateAll}" Command="{Binding MachineTranslateAllCommand}" />
          <Button x:Name="StopButton" Theme="{DynamicResource BorderlessButton}" Content="{loc:Str Stop}" Command="{Binding StopTranslatingCommand}" IsVisible="{Binding IsTranslating}" />
          <Button Theme="{DynamicResource BorderlessButton}" Content="{loc:Str CopySource}" Command="{Binding CopySourceCommand}" />
          <Button Theme="{DynamicResource BorderlessButton}" Content="{loc:Str Merge}" Command="{Binding MergeCommand}" />
          <Button Theme="{DynamicResource BorderlessButton}" Content="{loc:Str Split}" Command="{Binding SplitCommand}" />
          <Button Theme="{DynamicResource BorderlessButton}" Content="{loc:Str ClearTargets}" Command="{Binding ClearTargetsCommand}" />
          <Button Theme="{DynamicResource BorderlessButton}" Content="{loc:Str EditSource}" Command="{Binding EditSourceCommand}" />
          <Button Theme="{DynamicResource BorderlessButton}" Content="{loc:Str EditWholeSource}" Command="{Binding EditWholeSourceCommand}" />
          <DropDownButton Theme="{DynamicResource BorderlessDropDownButton}" Content="{loc:Str LlmSegment}" IsEnabled="{Binding !IsTranslating}">
            <DropDownButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="{loc:Str LlmSegmentBlock}" Command="{Binding LlmSegmentBlockCommand}" />
                <MenuItem Header="{loc:Str LlmSegmentFile}" Command="{Binding LlmSegmentFileCommand}" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" Content="{loc:Str OnlyNeedsReview}" IsChecked="{Binding OnlyNeedsReview}" />
        </WrapPanel>
      </DockPanel>
    </Border>

    <Panel>
      <preview:MarkdownView x:Name="PreviewView" IsVisible="{Binding IsPreview}" Markdown="{Binding PreviewMarkdown}" />

      <DockPanel IsVisible="{Binding !IsPreview}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="44,*,*,32" Margin="8,6" IsVisible="{Binding !IsSideBySide}">
          <TextBlock Grid.Column="1" Text="{loc:Str ColumnSource}" Foreground="{DynamicResource SemiColorText2}" Margin="8,0" />
          <TextBlock Grid.Column="2" Text="{loc:Str ColumnTarget}" Foreground="{DynamicResource SemiColorText2}" Margin="8,0" />
        </Grid>

        <Border DockPanel.Dock="Bottom" Padding="12,8" MaxHeight="180"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="2*,24,*">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{loc:Str Matches}" Foreground="{DynamicResource SemiColorText2}" Margin="0,0,0,4" />
              <TextBlock DockPanel.Dock="Top" Text="{loc:Str NoMatches}" Foreground="{DynamicResource SemiColorText3}"
                         IsVisible="{Binding !Matches.Count}" />
              <ScrollViewer>
                <ItemsControl x:Name="MatchList" ItemsSource="{Binding Matches}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TmMatchViewModel">
                      <Grid ColumnDefinitions="28,48,*" Margin="0,2">
                        <TextBlock Text="{Binding Number}" Foreground="{DynamicResource SemiColorText3}" />
                        <TextBlock Grid.Column="1" Text="{Binding Score}" Foreground="{DynamicResource SemiColorPrimary}" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="{Binding Target}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Source}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Text="{loc:Str GlossaryHits}" Foreground="{DynamicResource SemiColorText2}" Margin="0,0,0,4" />
              <TextBlock DockPanel.Dock="Top" Text="{loc:Str NoGlossaryHits}" Foreground="{DynamicResource SemiColorText3}"
                         IsVisible="{Binding !Hits.Count}" />
              <ScrollViewer>
                <ItemsControl x:Name="HitList" ItemsSource="{Binding Hits}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GlossaryHitViewModel">
                      <StackPanel Margin="0,2">
                        <TextBlock TextWrapping="Wrap">
                          <Run Text="{Binding Source}" />
                          <Run Text=" → " Foreground="{DynamicResource SemiColorText3}" />
                          <Run Text="{Binding Target}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap"
                                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>

        <views:SideBySideView x:Name="SideBySide" IsVisible="{Binding IsSideBySide}" />
        <ListBox x:Name="RowList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 SelectionMode="Multiple" SelectedItems="{Binding SelectedRows}" IsVisible="{Binding !IsSideBySide}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:SegmentRowViewModel">
              <Border Classes="row" Classes.blockStart="{Binding IsBlockStart}">
                <Grid ColumnDefinitions="44,*,*,32">
                  <TextBlock Text="{Binding Number}" Foreground="{DynamicResource SemiColorText3}" Margin="0,2,0,0" />
                  <SelectableTextBlock x:Name="SourceText" Grid.Column="1" Margin="8,2" TextWrapping="Wrap"
                                       controls:Highlight.Parts="{Binding SourceParts}" ToolTip.Tip="{Binding GlossaryTip}"
                                       Classes.verbatim="{Binding IsVerbatim}"
                                       SelectionStart="{Binding SourceCaret, Mode=OneWayToSource}"
                                       DoubleTapped="OnSourceDoubleTapped" />
                  <Panel Grid.Column="2" Margin="8,0">
                    <TextBlock Margin="0,2" TextWrapping="Wrap" Text="{Binding Target}"
                               Classes.verbatim="{Binding IsVerbatim}" IsVisible="{Binding !IsEditing}" />
                    <ContentControl Content="{Binding EditTarget}">
                      <ContentControl.ContentTemplate>
                        <DataTemplate DataType="vm:SegmentRowViewModel">
                          <StackPanel Spacing="4">
                            <Border BorderBrush="{DynamicResource SemiColorPrimary}" BorderThickness="1" CornerRadius="4" Padding="4,2">
                              <editor:MarkdownEditor x:Name="TargetEditor" Markdown="{Binding Target}" FocusOnAttach="True" MinHeight="24" />
                            </Border>
                            <Button x:Name="RowMachineTranslate" HorizontalAlignment="Left" Padding="8,2" FontSize="12"
                                    Theme="{DynamicResource BorderlessButton}" Content="{loc:Str MachineTranslate}"
                                    IsVisible="{Binding !IsVerbatim}"
                                    Command="{Binding $parent[ListBox].((vm:SegmentGridViewModel)DataContext).MachineTranslateCommand}" />
                          </StackPanel>
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                  </Panel>
                  <TextBlock Grid.Column="3" Classes="status" Margin="0,2,0,0"
                             Classes.draft="{Binding IsDraft}" Classes.confirmed="{Binding IsConfirmed}" Classes.review="{Binding NeedsReview}"
                             Text="{Binding StatusGlyph}" ToolTip.Tip="{Binding StatusText}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>
