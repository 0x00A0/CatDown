<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CatDown.App.ViewModels"
        xmlns:loc="using:CatDown.App.Localization"
        xmlns:views="using:CatDown.App.Views"
        x:Class="CatDown.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="820" MinWidth="800" MinHeight="500">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8"
            BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <DropDownButton x:Name="RulesButton" Theme="{DynamicResource BorderlessDropDownButton}"
                          Content="{loc:Str SegmentationRules}" IsEnabled="{Binding HasProject}">
            <DropDownButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="{loc:Str ImportSrx}" Command="{Binding ImportSrxCommand}" />
                <MenuItem Header="{loc:Str RemoveSrx}" Command="{Binding RemoveSrxCommand}" />
                <MenuItem Header="{loc:Str ResegmentFile}" Command="{Binding ResegmentFileCommand}" IsEnabled="{Binding HasFile}" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button x:Name="GlossaryButton" Theme="{DynamicResource BorderlessButton}" Content="{loc:Str Glossary}"
                  Command="{Binding OpenGlossaryCommand}" IsEnabled="{Binding HasProject}" />
          <DropDownButton x:Name="ExportButton" Content="{loc:Str Export}" IsEnabled="{Binding HasProject}">
            <DropDownButton.Flyout>
              <MenuFlyout>
                <MenuItem Header="{loc:Str ExportCurrent}" Command="{Binding ExportCurrentCommand}" IsEnabled="{Binding HasFile}" />
                <MenuItem Header="{loc:Str ExportAll}" Command="{Binding ExportAllCommand}" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button x:Name="SettingsButton" Theme="{DynamicResource BorderlessButton}"
                  Content="{loc:Str Settings}" Command="{Binding OpenSettingsCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button x:Name="OpenFolderButton" Content="{loc:Str OpenFolder}" Command="{Binding OpenFolderCommand}" />
          <Button x:Name="NewFileButton" Theme="{DynamicResource BorderlessButton}" Content="{loc:Str NewFile}"
                  Command="{Binding NewFileCommand}" IsEnabled="{Binding HasProject}" />
          <TextBlock x:Name="LanguagePair" VerticalAlignment="Center" Text="{Binding LanguagePairText}"
                     Foreground="{DynamicResource SemiColorText2}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Padding="12,6" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{DynamicResource SemiColorWarningLight}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Theme="{DynamicResource BorderlessButton}" Content="×"
                Command="{Binding DismissNoticeCommand}" Padding="8,0" />
        <TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Notice}" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="260,4,*">
      <TreeView x:Name="FileTree" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedNode}" Margin="4,8">
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:FileNode" ItemsSource="{Binding Children}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding ProgressText}"
                         Foreground="{DynamicResource SemiColorText2}" />
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <GridSplitter Grid.Column="1" Background="{DynamicResource SemiColorBorder}" ResizeDirection="Columns" />
      <Panel Grid.Column="2">
        <ContentControl x:Name="EditorHost" Content="{Binding Editor}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:SegmentGridViewModel">
              <views:SegmentGridView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource SemiColorText2}"
                   Text="{loc:Str NoProject}" IsVisible="{Binding !HasProject}" />
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource SemiColorText2}" Text="{loc:Str NoFile}">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasProject" />
              <Binding Path="!HasFile" />
            </MultiBinding>
          </TextBlock.IsVisible>
        </TextBlock>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
